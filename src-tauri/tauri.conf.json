{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoniChain",
  "version": "1.0.0",
  "identifier": "com.matteocarusolinardon.sonichain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SoniChain",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Matteo Caruso Linardon",
    "copyright": "Copyright © 2026 Matteo Caruso Linardon",
    "shortDescription": "Real-time crypto market sonification",
    "longDescription": "SoniChain turns live cryptocurrency market data into generative sound, streaming trades from Binance and synthesizing music whose pitch, rhythm, and timbre track the market in real time."
  }
}
